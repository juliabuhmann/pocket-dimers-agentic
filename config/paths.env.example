# Data roots used by the pipeline.
# Copy to config/paths.env, edit, then `set -a; source config/paths.env; set +a` before running scripts.
# The values below are the mount points on the ETH Euler cluster where the study ran. Each script
# falls back to that value when the variable is unset, so behaviour on the original system is unchanged.
# Dataset versions, checksums and licences: project_record/DATA.md.

# Repository root. Lock files in envs/ (pockets*.txt, conda_af3.txt) install tools from
# ${REPO_ROOT}/tools/<name> (pip expands ${VAR} in requirements files).
REPO_ROOT=/path/to/pocket-dimers-agentic

# Local wwPDB mmCIF mirror, layout <id[1:3]>/<id>.cif.gz.
# Read by: src/part1/config.py, scripts/{pdbsite_common,h4_common,fpocket_pdbsite,cofold_select_h4,
#          cofold_metrics_h4,cofold_metrics_onaxis}.py (and every script importing PDB_MIRROR from them).
PDB_MIRROR=/cluster/scratch/jjaenes/pdb

# AlphaFold DB quaternary (dimer) models; scripts use $DIMERS_ROOT/afdb_human_dimers/{homodimers,heterodimers}.
# Read by: scripts/{run_dimer_pockets,annotate_pocket_chains,q22_common,h4_common,h5_residue_features,
#          cofold_select_dimeronly,fetch_tool_test_inputs}.py, scripts/data_checksums.sh.
DIMERS_ROOT=/cluster/scratch/gmagnusson/dimers

# AFDB pocket atlas (BURROW + pocketcompare output).
# Read by: scripts/test_pocketcompare.py, scripts/data_checksums.sh (as ATLAS_ROOT);
#          scripts/snapshot_atlas.sh reads the same location as ATLAS_SRC.
ATLAS_ROOT=/cluster/scratch/gmagnusson/pocketcompare_afdb
ATLAS_SRC=/cluster/scratch/gmagnusson/pocketcompare_afdb

# Precomputed AlphaFold3 MSAs.
# Read by: scripts/{make_af3_input,make_boltz_input,cofold_select_h4,cofold_select_onaxis}.py, scripts/listing_hashes.sh.
AF3_MSA_HUMAN=/cluster/project/beltrao/shared/25.05_alphafold3_msas_human
# Read by: scripts/listing_hashes.sh.
AF3_MSA_YEAST=/cluster/project/beltrao/shared/25.06_alphafold3_msas_yeast

# AFDB v6 proteome tar files.
# Read by: scripts/listing_hashes.sh. Hard-coded (not yet env-driven): scripts/ligysis_01b_extract_models.py.
AFDB_V6_ROOT=/cluster/work/beltrao/shared/alphafold/v6

# AlphaFold3 model weights (obtain from Google DeepMind under the AF3 Model Parameters Terms of Use).
# Read by: scripts/setup_cofold.sh.
AF3_WEIGHTS_ZST=/cluster/project/beltrao/shared/alphafold3/models/af3.bin.zst

# Optional contact address appended to the HTTP User-Agent of scripts/extlib.py (empty = no contact).
CONTACT_EMAIL=

# Still hard-coded to the defaults above (not converted; edit by hand if your mounts differ):
#   scripts/ligysis_01b_extract_models.py (AFDB v6 human tar), scripts/ligysis_04_burrow_exp.py (PDB mirror),
#   scripts/summarize_pocket_run.py (dimer models, inline f-string), and the independent verifier
#   scripts under reviews/ (PDB mirror and dimer model paths).
